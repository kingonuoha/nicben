*.tsbuildinfo
tsconfig.tsbuildinfo

# Environment — never commit real values; .env.example only
.env
.env*.local
.env.production

# Testing
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS artifacts
.DS_Store
Thumbs.db

# Vercel
.vercel

# Editor
.idea/
.vscode/*
!.vscode/extensions.json
