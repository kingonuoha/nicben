# NicBen application source repository
# Companion to the agentic repo (github.com/kingonuoha/project-agents, branch: nicben)
# The agentic repo deliberately gitignores /web/ — this repository is that code's home.

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
dist/

