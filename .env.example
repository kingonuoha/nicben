# NICBEN Asset Holdings & Investments — environment template
#
# `decisions.md` D-024: this file is committed with **placeholders and comments
# only, never real values** (`06-tech-and-security-spec.md` §37). It closes the
# outstanding Step 1 requirement of `07-build-order.md`.
#
# Copy it to `.env.local` (which is gitignored) and fill in real values there.
#
# Nothing in this list is required for `npm run install` / `npm run build` /
# `npm run type-check` / `npm run lint` to succeed. That is deliberate: D-019,
# D-020 and D-022 were each chosen so the build, the tests and the credentials-absent
# deployment stay green before the client has provisioned any vendor account.
# Each variable below documents what the application does **without** it.

# ---------------------------------------------------------------------------
# Database — MongoDB Atlas (decisions.md D-019)
# ---------------------------------------------------------------------------
# Reached only through the repository port `lib/data/` — nothing else in the
# application imports the `mongodb` driver.
#
# ABSENT: the in-process dev adapter is selected and a warning is logged. The
# application runs and the enquiry pipeline works, but records live in the memory
# of a single instance and are lost on restart, so this is not a production state.
MONGODB_URI=

# Atlas database name. Defaults to `nicben` when unset.
MONGODB_DB=

# ---------------------------------------------------------------------------
# Email notifications — Resend (decisions.md D-021)
# ---------------------------------------------------------------------------
# Both variables are needed before any notification is attempted.
#
# ABSENT: the enquiry is still stored and the user still sees the success card.
# The send is skipped, `notification.error` is set to `not-configured` on the
# stored record, and the admin view surfaces it for follow-up.
RESEND_API_KEY=

# The inbox that receives new-enquiry notifications. Must be an address the
# Resend account is permitted to send to.
ENQUIRY_NOTIFY_TO=

# ---------------------------------------------------------------------------
# Spam protection — Cloudflare Turnstile (decisions.md D-022)
# ---------------------------------------------------------------------------
# The site key is public by design (it is rendered into the page). It is read
# server-side and passed to the client component as a prop, which is why it does
# not carry a NEXT_PUBLIC_ prefix.
TURNSTILE_SITE_KEY=

# SECRET — never commit a value, never expose it to the browser.
#
# ABSENT in development/testing: verification is skipped and a warning is logged.
# ABSENT in production: every submission is REJECTED (D-022, "fail closed"),
# because an unverified submission is precisely what the control exists to stop.
# The honeypot field is always active regardless of this setting.
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Attachment storage — Vercel Blob, private (decisions.md D-020)
# ---------------------------------------------------------------------------
# SECRET — never commit a value.
#
# ABSENT: the attachment field is not rendered on `/contact` at all. This is
# intentional: an input that silently discards the chosen file is worse than an
# absent field, because the sender believes their evidence was submitted.
# Objects are written with `access: "private"` and are never served from a public
# URL; only the storage key is recorded (06 §57).
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Admin portal credentials — decisions.md D-026 … D-030
# ---------------------------------------------------------------------------
# The hidden administrative portal at /admin. Nothing here is required for the
# build, the type-check or the tests to pass: with all three absent there is simply
# no admin account, so every login attempt is rejected (D-028, "fail closed") and
# the portal cannot be entered by accident.
#
# Generate the hash with:
#   node scripts/hash-admin-password.mjs
# The script never writes the password anywhere; it prints only the hash. Full
# production provisioning is documented in web/docs/admin-provisioning.md.

# The portal's single operator account. Lower-cased on read.
#
# ABSENT: the dev adapter seeds no admin, so there is nothing to authenticate and
# D-028 rejects every attempt. With MongoDB provisioned, the `adminUsers` collection
# is the authority and this variable is not consulted at all.
ADMIN_EMAIL=

# SECRET — an argon2id hash, never a plaintext password. Committed values are
# forbidden: a hash is still credential material (06 §37).
#
# The value must be a `$argon2id$…` PHC string. A plaintext password pasted here is
# detected by shape and refused loudly rather than silently becoming a credential
# that happens to be unreachable.
#
#   node scripts/hash-admin-password.mjs            # prompts, prints the hash
#
# ABSENT: same fail-closed outcome as ADMIN_EMAIL above.
ADMIN_PASSWORD_HASH=

# SECRET — the HMAC key that signs the session cookie (D-027). 32+ random bytes,
# base64 or hex. Never commit a value.
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# ABSENT: a per-boot ephemeral secret is generated and a loud warning is logged.
# Sessions then do not survive a restart and are not valid across instances. There
# is deliberately NO hardcoded fallback: a literal default would be a universal
# forgery key published with the source.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Site origin
# ---------------------------------------------------------------------------
# Absolute origin used by sitemap.xml, robots.txt and canonical URLs.
# Example shape: https://www.example.com  (no trailing slash)
#
# ABSENT: falls back to http://localhost:3000. The production domain is
# `[CLIENT TO CONFIRM]` and D-012 forbids substituting a plausible one.
NEXT_PUBLIC_SITE_URL=
